{
  "enabledPlugins": {
    "github@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["miro", "excalidraw"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "npm run lint && npm run test && npm run build",
            "timeout": 120,
            "statusMessage": "Running pre-commit checks (lint, test, build)..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/packages/sensors/src/pr-gate-hook.mjs\"",
            "timeout": 900,
            "statusMessage": "PR gate: lint, typecheck, test, build and the other sensors must be green..."
          }
        ]
      }
    ]
  }
}
