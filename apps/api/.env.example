PORT=3001
NODE_ENV=development
# Local dev (API on host machine): use localhost
# Docker deploy (API in container): change to "db"
DATABASE_URL=postgresql://postgres:password@localhost:5432/futmeet
ALLOWED_ORIGINS=http://localhost:5173
# Public base URL of the SPA. Share preview pages (GET /share/rooms/:id, /share/results/:id)
# redirect browsers here. Optional; defaults to http://localhost:5173
SPA_BASE_URL=http://localhost:5173
API_KEY=change-me-in-production
LOG_LEVEL=info
